{
  "name": "mongodb-model-viewer",
  "private": true,
  "version": "1.1.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "author": {
    "name": "Yaser Yamil Meshir Vargas",
    "email": "yaser@example.com"
  },
  "homepage": "https://example.com/mongodb-model-viewer",
  "description": "MongoDB schema and diagram designer for collections, fields, data dictionaries, indexes and relations.",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "desktop:clean": "powershell -Command \"if (Test-Path 'dist') { Remove-Item -LiteralPath 'dist' -Recurse -Force }; if (Test-Path 'release') { Remove-Item -LiteralPath 'release' -Recurse -Force }\"",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:dev:main\"",
    "desktop:dev:main": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "desktop:pack": "npm run build && npm exec electron-builder -- --dir",
    "desktop:pack:fast": "npm exec electron-builder -- --dir",
    "desktop:pack:win": "npm run build && npm exec electron-builder -- --win dir --x64",
    "desktop:pack:win:fast": "npm exec electron-builder -- --win dir --x64",
    "desktop:verify:win-unpacked": "npm run desktop:clean && npm run desktop:pack:win",
    "desktop:dist": "npm run build && npm exec electron-builder --",
    "desktop:dist:fast": "npm exec electron-builder --",
    "desktop:dist:win": "npm run build && npm exec electron-builder -- --win portable --x64",
    "desktop:dist:win:fast": "npm exec electron-builder -- --win portable --x64",
    "desktop:dist:win:installer": "npm run build && npm exec electron-builder -- --win nsis --x64",
    "desktop:dist:win:installer:deepin": "PATH=\"/opt/deepin-wine11-stable/bin:$PATH\" npm run build && PATH=\"/opt/deepin-wine11-stable/bin:$PATH\" npm exec electron-builder -- --win nsis --x64",
    "desktop:dist:win:installer:fast": "npm exec electron-builder -- --win nsis --x64",
    "desktop:dist:win:installer:clean": "npm run desktop:clean && npm run build && npm exec electron-builder -- --win nsis --x64 --publish never",
    "desktop:dist:linux": "npm run build && ./node_modules/.bin/electron-builder --linux AppImage deb pacman --arm64 --x64",
    "desktop:dist:linux:fast": "./node_modules/.bin/electron-builder --linux AppImage deb pacman --arm64 --x64",
    "desktop:dist:linux:arm64": "npm run build && ./node_modules/.bin/electron-builder --linux AppImage deb pacman --arm64",
    "desktop:dist:linux:x64": "npm run build && ./node_modules/.bin/electron-builder --linux AppImage deb pacman --x64",
    "desktop:dist:linux:arch": "npm run build && ./node_modules/.bin/electron-builder --linux pacman --x64",
    "desktop:dist:mac": "npm run build && npm exec electron-builder -- --mac dmg zip --arm64 --x64 --publish never",
    "desktop:dist:mac:fast": "npm exec electron-builder -- --mac dmg zip --arm64 --x64 --publish never",
    "desktop:dist:mac:arm64": "npm run build && npm exec electron-builder -- --mac dmg zip --arm64 --publish never",
    "desktop:dist:mac:x64": "npm run build && npm exec electron-builder -- --mac dmg zip --x64 --publish never"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "dompurify": "^3.4.12",
    "embla-carousel-react": "8.6.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "input-otp": "1.4.2",
    "json5": "^2.2.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "ollama": "^0.6.3",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.4",
    "@tailwindcss/oxide-darwin-arm64": "^4.1.12",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.12",
    "vite": "^6.4.2",
    "wait-on": "^8.0.5"
  },
  "desktopName": "MongoDBModeler",
  "build": {
    "appId": "com.babel.mongodbmodelviewer",
    "productName": "MongoDBModeler",
    "icon": "icono.ico",
    "asar": true,
    "compression": "store",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419"
    ],
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "mdm",
        "name": "MongoDB Model File",
        "description": "MongoDB model project file",
        "role": "Editor"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "MongoDBModeler",
      "icon": "icono.ico",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MongoDBModeler",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "icono.ico",
      "uninstallerIcon": "icono.ico",
      "installerHeaderIcon": "icono.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "mac": {
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
